<!DOCTYPE html>
<html>
  <head>
    <title>Home Assistant</title>
    <%= renderTemplate("_header.html.template") %>
    <%= renderTemplate("_style_base.html.template") %>
    <style>
      html {
        background-color: var(--primary-background-color, #f3f2ef);
        color: var(--primary-text-color, #141517);
      }
      @media (prefers-color-scheme: dark) {
        html {
          background-color: var(--primary-background-color, #0b0c0e);
          color: var(--primary-text-color, #f2f3f5);
        }
      }
      html {
        background-image: radial-gradient(
          900px 640px at 50% 40%,
          var(--card-background-color, #ffffff) 0%,
          transparent 72%
        );
        background-attachment: fixed;
      }
      @media (prefers-color-scheme: dark) {
        html {
          background-image: radial-gradient(
            900px 640px at 50% 40%,
            var(--card-background-color, #1c1f24) 0%,
            transparent 72%
          );
        }
      }
      body {
        box-sizing: border-box;
        padding: 32px 0;
        font-family: "Inter Tight", Inter, Roboto, system-ui, sans-serif;
        display: flex;
        flex-wrap: wrap;
        align-items: center;
      }
      .content {
        width: 100%;
        max-width: 400px;
        margin: 0 auto;
        padding: var(--safe-area-inset-top, 0px)
          calc(16px + var(--safe-area-inset-right, 0px))
          var(--safe-area-inset-bottom, 0px)
          calc(16px + var(--safe-area-inset-left, 0px));
        box-sizing: content-box;
      }

      .header {
        display: flex;
        align-items: center;
        justify-content: center;
        margin-bottom: 32px;
      }

      .header {
        flex-direction: column;
        gap: 14px;
      }
      .header img {
        height: 40px;
        width: 40px;
        border-radius: 12px;
      }
      .header .brand {
        font-size: 13px;
        font-weight: 500;
        letter-spacing: 0.32em;
        padding-left: 0.32em;
      }
    </style>
  </head>
  <body>
    <div class="content">
      <div class="header">
        <img src="/static/icons/favicon-192x192.png" alt="" />
        <span class="brand">HOME ASSISTANT</span>
      </div>
      <ha-authorize></ha-authorize>
    </div>
    <%= renderTemplate("_js_base.html.template") %>
    <%= renderTemplate("_preload_roboto.html.template") %>
    <%= renderTemplate("_script_loader.html.template") %>
    <script crossorigin="use-credentials">
      if (window.latestJS) {
        window.providersPromise = fetch("<%= hassUrl %>/auth/providers", {
          credentials: "same-origin",
        });
      }
    </script>
  </body>
</html>
