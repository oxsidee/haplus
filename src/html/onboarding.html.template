<!DOCTYPE html>
<html>
  <head>
    <title>Home Assistant</title>
    <%= renderTemplate("_header.html.template") %>
    <%= renderTemplate("_style_base.html.template") %>
    <style>
      html {
        background-color: var(--primary-background-color, #f3f2ef);
        color: var(--primary-text-color, #141517);
      }
      @media (prefers-color-scheme: dark) {
        html {
          background-color: var(--primary-background-color, #0b0c0e);
          color: var(--primary-text-color, #f2f3f5);
        }
      }
      html {
        background-image: radial-gradient(
          900px 640px at 50% 30%,
          var(--card-background-color, #ffffff) 0%,
          transparent 72%
        );
        background-attachment: fixed;
      }
      @media (prefers-color-scheme: dark) {
        html {
          background-image: radial-gradient(
            900px 640px at 50% 30%,
            var(--card-background-color, #1c1f24) 0%,
            transparent 72%
          );
        }
      }
      body {
        height: auto;
        padding: 32px 0;
        font-family: "Inter Tight", Inter, Roboto, system-ui, sans-serif;
      }

      .content {
        max-width: min(560px, calc(100vw - var(--safe-area-inset-right, 0px) - var(--safe-area-inset-left, 0px)));
        margin: 0 auto;
        padding: 0 16px;
        box-sizing: content-box;
      }

      .header {
        display: flex;
        align-items: center;
        justify-content: flex-start;
        margin-bottom: 32px;
        margin-left: 32px;
        padding-top: var(--safe-area-inset-top);
      }

      .header {
        gap: 14px;
      }
      .header img {
        height: 40px;
        width: 40px;
        border-radius: 12px;
      }
      .header .brand {
        font-size: 13px;
        font-weight: 500;
        letter-spacing: 0.32em;
      }
    </style>
  </head>
  <body id="particles">
    <div class="content">
      <div class="header">
        <img src="/static/icons/favicon-192x192.png" alt="" />
        <span class="brand">HOME ASSISTANT</span>
      </div>
      <ha-onboarding></ha-onboarding>
    </div>
    <%= renderTemplate("_js_base.html.template") %>
    <%= renderTemplate("_preload_roboto.html.template") %>
    <%= renderTemplate("_script_loader.html.template") %>
    <script crossorigin="use-credentials">
      if (window.latestJS) {
        window.stepsPromise = fetch("<%= hassUrl %>/api/onboarding", {
          credentials: "same-origin",
        });
      }
    </script>
  </body>
</html>
